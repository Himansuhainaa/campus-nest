# ---------------------------------------------------------------------------
# CampusNest — server environment
# Copy this file to `.env` (same folder) and fill in real values.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows cmd)
# ---------------------------------------------------------------------------

# REQUIRED — MongoDB connection string.
#   Local mongod:  mongodb://127.0.0.1:27017/campusnest
#   MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusnest?retryWrites=true&w=majority
# If your password contains @ : / ? # [ ] it must be percent-encoded.
MONGODB_URI=mongodb://127.0.0.1:27017/campusnest

# REQUIRED — secret used to sign JWTs. Use a long random string in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional — how long a login stays valid (zeit/ms format). Default: 7d
JWT_EXPIRES_IN=7d

# Optional — port the API listens on. Default: 5000
# Render/Railway inject their own PORT; leave this alone there.
PORT=5000

# Optional — comma-separated list of browser origins allowed to call this API.
# Leave EMPTY/unset to allow all origins (fine for local dev).
# In production set it to your deployed frontend, e.g.
#   CLIENT_ORIGIN=https://campus-nest.vercel.app
CLIENT_ORIGIN=

# Optional — set to "production" on your host. The seed script refuses to run
# against a production database unless you also pass --force.
NODE_ENV=development

# Optional — where uploaded images are written. Defaults to server/uploads.
# Set this to a mounted persistent disk in production (free tiers have an
# ephemeral filesystem, so uploads are lost on restart without one).
# UPLOAD_DIR=/var/data/uploads

# Optional — database used by `npm test`. Defaults to campusnest_test.
# The name MUST end in "_test"; the suite drops the database when it finishes.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/campusnest_test
