# ---------------------------------------------------------------------------
# CampusNest — server environment
# Copy this file to `.env` (same folder) and fill in real values.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows cmd)
# ---------------------------------------------------------------------------

# REQUIRED — MongoDB connection string.
#   Local mongod:  mongodb://127.0.0.1:27017/campusnest
#   MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusnest?retryWrites=true&w=majority
# If your password contains @ : / ? # [ ] it must be percent-encoded.
MONGODB_URI=mongodb://127.0.0.1:27017/campusnest

# REQUIRED — secret used to sign JWTs. Use a long random string in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional — how long a login stays valid (zeit/ms format). Default: 7d
JWT_EXPIRES_IN=7d

# Optional — port the API listens on. Default: 5000
# Render/Railway inject their own PORT; leave this alone there.
PORT=5000

# Optional — comma-separated list of browser origins allowed to call this API.
# Leave EMPTY/unset to allow all origins (fine for local dev).
# In production set it to your deployed frontend, e.g.
#   CLIENT_ORIGIN=https://campus-nest.vercel.app
CLIENT_ORIGIN=

# Optional — set to "production" on your host. The seed script refuses to run
# against a production database unless you also pass --force.
NODE_ENV=development

# ---------------------------------------------------------------------------
# IMAGE STORAGE
#
# Set CLOUDINARY_URL and uploads go to Cloudinary, where they survive restarts
# and redeploys. Leave it unset and uploads go to local disk instead — fine for
# development, but on a free host (Render, Railway) the filesystem is ephemeral
# and every uploaded photo is lost when the service restarts.
#
# Get the value from your Cloudinary dashboard: it is shown as the "API
# environment variable" and looks exactly like this:
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ---------------------------------------------------------------------------
# CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@your-cloud

# Alternative to CLOUDINARY_URL — set all three, or none.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional — folder inside your Cloudinary account. Default: campus-nest
# CLOUDINARY_FOLDER=campus-nest

# Optional — where uploads are written when Cloudinary is NOT configured.
# Defaults to server/uploads.
# UPLOAD_DIR=/var/data/uploads

# ---------------------------------------------------------------------------
# MODERATION
#
# Comma-separated emails that get the "admin" role and access to /admin.
# Applied on registration AND re-checked on every login, so adding or removing
# an address here takes effect without touching the database. Role is never
# taken from anything a client sends.
# ---------------------------------------------------------------------------
# ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# EMAIL (optional)
#
# Set SMTP_URL and new accounts must confirm their address before posting
# reviews. Leave it unset and email is disabled entirely — accounts are created
# already verified, so nobody is locked out of a site that cannot send mail.
#
# Gmail needs an App Password, not your login password:
#   SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# Brevo free tier:
#   SMTP_URL=smtp://user:key@smtp-relay.brevo.com:587
# Percent-encode @ and any special characters, same as a Mongo URI.
# ---------------------------------------------------------------------------
# SMTP_URL=
# MAIL_FROM=CampusNest <no-reply@yourdomain.com>

# Where confirmation links point. Falls back to CLIENT_ORIGIN, then localhost.
# CLIENT_URL=https://campus-nest-kappa.vercel.app

# Optional — set to "true" to turn off rate limiting. Limits exist to stop one
# visitor burning through the free tiers everything here runs on; only disable
# them if you have a specific reason. The test suite disables them automatically.
# DISABLE_RATE_LIMIT=false

# Optional — database used by `npm test`. Defaults to campusnest_test.
# The name MUST end in "_test"; the suite drops the database when it finishes.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/campusnest_test
