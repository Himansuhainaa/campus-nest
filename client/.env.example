# ---------------------------------------------------------------------------
# CampusNest — client environment
# Copy this file to `.env` (same folder) and adjust if needed.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows cmd)
#
# Vite only exposes variables that start with VITE_, and it reads them at BUILD
# time — after changing this file, restart `npm run dev` (or redeploy).
# ---------------------------------------------------------------------------

# REQUIRED — base URL of the CampusNest API, including the /api suffix.
#   Local dev:  http://localhost:5000/api
#   Production: https://<your-service>.onrender.com/api
VITE_API_URL=http://localhost:5000/api
