# ---------------------------------------------------------------------------
# CampusNest — client environment
# Copy this file to `.env` (same folder) and adjust if needed.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows cmd)
#
# Vite only exposes variables that start with VITE_, and it reads them at BUILD
# time — after changing this file, restart `npm run dev` (or redeploy).
# ---------------------------------------------------------------------------

# REQUIRED — base URL of the CampusNest API, including the /api suffix.
#   Local dev:  http://localhost:5000/api
#   Production: https://<your-service>.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# PRODUCT ANALYTICS — PostHog (optional)
#
# Leave these unset and analytics is disabled entirely; the app runs exactly
# the same. Set VITE_POSTHOG_KEY and you get pageviews, autocaptured clicks,
# and named funnel events (search -> listing viewed -> review form opened ->
# review submitted, and the signup funnel) so you can see where users drop off.
#
# Get the values from a free posthog.com project: Project Settings -> the
# "Project API Key" (starts with phc_) and your region's host.
# ---------------------------------------------------------------------------
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional — set to "true" to also capture session recordings (heavier, and
# more privacy-sensitive). All input fields are masked either way.
# VITE_POSTHOG_RECORD=false
